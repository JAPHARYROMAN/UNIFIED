{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unified.local/schemas/phase9-refinance-deployment-candidate-v1.json",
  "title": "UNIFIED Phase 9 refinance non-activating deployment candidate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "artifact_type", "environment", "contains_real_value", "chain_id",
    "topology_only", "topology_verified", "role_grant_performed", "plan_sha256",
    "reset_identity", "source_commit", "broadcaster", "latest_nonce_before",
    "pending_nonce_before", "latest_nonce_prepared", "pending_nonce_prepared",
    "starting_nonce", "final_nonce", "role_manager", "loan_registry", "settlement_token",
    "quote_policy_registry", "refinance_policy_registry", "amendment_policy_registry",
    "protection_policy_registry", "recovery_policy_registry", "asset_registry",
    "emergency_controller", "treasury_fee_recipient", "maximum_quote_validity",
    "configuration_hash", "role_before_absent", "role_after_absent",
    "predicted_lien_registry", "actual_lien_registry", "lien_registry_runtime_code_hash",
    "predicted_collateral_custody", "actual_collateral_custody", "collateral_custody_runtime_code_hash",
    "predicted_loan_account_implementation", "actual_loan_account_implementation", "loan_account_implementation_runtime_code_hash",
    "predicted_position_manager_implementation", "actual_position_manager_implementation", "position_manager_implementation_runtime_code_hash",
    "predicted_phase9_loan_factory", "actual_phase9_loan_factory", "phase9_loan_factory_runtime_code_hash",
    "predicted_validation_module", "actual_validation_module", "validation_module_runtime_code_hash",
    "predicted_request_module", "actual_request_module", "request_module_runtime_code_hash",
    "predicted_lifecycle_module", "actual_lifecycle_module", "lifecycle_module_runtime_code_hash",
    "predicted_payoff_quote_engine", "actual_payoff_quote_engine", "payoff_quote_engine_runtime_code_hash",
    "predicted_refinance_coordinator", "actual_refinance_coordinator", "refinance_coordinator_runtime_code_hash",
    "activation_accepted", "post_broadcast_verification_required", "deployment_history_reverted"
  ],
  "properties": {
    "schema_version": { "const": 1 }, "artifact_type": { "const": "PHASE9_REFINANCE_DEPLOYMENT_CANDIDATE" },
    "environment": { "const": "local" }, "contains_real_value": { "const": false }, "chain_id": { "const": 31337 },
    "topology_only": { "const": true }, "topology_verified": { "const": false }, "role_grant_performed": { "const": false },
    "plan_sha256": { "$ref": "#/$defs/sha256" }, "reset_identity": { "$ref": "#/$defs/bytes32" },
    "source_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" }, "broadcaster": { "const": "0x70997970C51812dc3A010C7d01b50e0d17dc79C8" },
    "latest_nonce_before": { "const": "0x0" }, "pending_nonce_before": { "const": "0x0" },
    "latest_nonce_prepared": { "const": "0x1" }, "pending_nonce_prepared": { "const": "0x1" },
    "starting_nonce": { "const": 1 }, "final_nonce": { "const": 11 },
    "role_manager": { "$ref": "#/$defs/address" }, "loan_registry": { "$ref": "#/$defs/address" },
    "settlement_token": { "$ref": "#/$defs/address" }, "quote_policy_registry": { "$ref": "#/$defs/address" },
    "refinance_policy_registry": { "$ref": "#/$defs/address" }, "amendment_policy_registry": { "$ref": "#/$defs/address" },
    "protection_policy_registry": { "$ref": "#/$defs/address" }, "recovery_policy_registry": { "$ref": "#/$defs/address" },
    "asset_registry": { "$ref": "#/$defs/address" }, "emergency_controller": { "$ref": "#/$defs/address" },
    "treasury_fee_recipient": { "$ref": "#/$defs/address" }, "maximum_quote_validity": { "type": "string", "pattern": "^[1-9][0-9]*$" },
    "configuration_hash": { "$ref": "#/$defs/bytes32" }, "role_before_absent": { "const": true }, "role_after_absent": { "const": true },
    "predicted_lien_registry": { "$ref": "#/$defs/address" }, "actual_lien_registry": { "$ref": "#/$defs/address" }, "lien_registry_runtime_code_hash": { "$ref": "#/$defs/bytes32" },
    "predicted_collateral_custody": { "$ref": "#/$defs/address" }, "actual_collateral_custody": { "$ref": "#/$defs/address" }, "collateral_custody_runtime_code_hash": { "$ref": "#/$defs/bytes32" },
    "predicted_loan_account_implementation": { "$ref": "#/$defs/address" }, "actual_loan_account_implementation": { "$ref": "#/$defs/address" }, "loan_account_implementation_runtime_code_hash": { "$ref": "#/$defs/bytes32" },
    "predicted_position_manager_implementation": { "$ref": "#/$defs/address" }, "actual_position_manager_implementation": { "$ref": "#/$defs/address" }, "position_manager_implementation_runtime_code_hash": { "$ref": "#/$defs/bytes32" },
    "predicted_phase9_loan_factory": { "$ref": "#/$defs/address" }, "actual_phase9_loan_factory": { "$ref": "#/$defs/address" }, "phase9_loan_factory_runtime_code_hash": { "$ref": "#/$defs/bytes32" },
    "predicted_validation_module": { "$ref": "#/$defs/address" }, "actual_validation_module": { "$ref": "#/$defs/address" }, "validation_module_runtime_code_hash": { "$ref": "#/$defs/bytes32" },
    "predicted_request_module": { "$ref": "#/$defs/address" }, "actual_request_module": { "$ref": "#/$defs/address" }, "request_module_runtime_code_hash": { "$ref": "#/$defs/bytes32" },
    "predicted_lifecycle_module": { "$ref": "#/$defs/address" }, "actual_lifecycle_module": { "$ref": "#/$defs/address" }, "lifecycle_module_runtime_code_hash": { "$ref": "#/$defs/bytes32" },
    "predicted_payoff_quote_engine": { "$ref": "#/$defs/address" }, "actual_payoff_quote_engine": { "$ref": "#/$defs/address" }, "payoff_quote_engine_runtime_code_hash": { "$ref": "#/$defs/bytes32" },
    "predicted_refinance_coordinator": { "$ref": "#/$defs/address" }, "actual_refinance_coordinator": { "$ref": "#/$defs/address" }, "refinance_coordinator_runtime_code_hash": { "$ref": "#/$defs/bytes32" },
    "activation_accepted": { "const": false }, "post_broadcast_verification_required": { "const": true }, "deployment_history_reverted": { "const": false }
  },
  "$defs": {
    "address": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$", "not": { "const": "0x0000000000000000000000000000000000000000" } },
    "bytes32": { "type": "string", "pattern": "^0x[0-9a-f]{64}$" },
    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "digest": { "type": "string", "pattern": "^(0x|sha256:)[0-9a-f]{64}$" }
  }
}
