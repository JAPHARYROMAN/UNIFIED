{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unified.local/schemas/phase9-refinance-deployment-evidence-v1.json",
  "title": "UNIFIED Phase 9 refinance non-activating topology evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "artifact_type", "environment", "contains_real_value", "chain_id",
    "topology_only", "topology_verified", "role_grant_performed", "activation_accepted", "post_broadcast_verification_required",
    "deployment_history_reverted", "plan_sha256", "source_commit", "working_tree_clean", "generated_at", "broadcaster", "broadcaster_provenance", "starting_nonce", "final_nonce",
    "reset_identity", "reset_command", "nonce_transcript", "rpc_url", "rpc_chain_id", "addresses", "observations",
    "modules", "coordinator_links", "role_absence"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "artifact_type": { "const": "PHASE9_REFINANCE_TOPOLOGY_EVIDENCE" },
    "environment": { "const": "local" },
    "contains_real_value": { "const": false },
    "chain_id": { "const": 31337 },
    "topology_only": { "const": true },
    "topology_verified": { "const": true },
    "role_grant_performed": { "const": false },
    "activation_accepted": { "const": false },
    "post_broadcast_verification_required": { "const": false },
    "deployment_history_reverted": { "const": false },
    "plan_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "source_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "working_tree_clean": { "const": true },
    "generated_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "broadcaster": { "const": "0x70997970c51812dc3a010c7d01b50e0d17dc79c8" },
    "broadcaster_provenance": { "$ref": "#/$defs/broadcasterProvenance" },
    "starting_nonce": { "const": 1 },
    "final_nonce": { "const": 11 },
    "reset_identity": { "$ref": "#/$defs/bytes32" },
    "reset_command": { "const": "pwsh ./scripts/smoke-phase9-refinance-anvil.ps1" },
    "nonce_transcript": { "$ref": "#/$defs/finalNonceTranscript" },
    "rpc_url": { "const": "http://127.0.0.1:18545" },
    "rpc_chain_id": { "const": "0x7a69" },
    "addresses": { "type": "object", "minProperties": 10, "maxProperties": 10, "additionalProperties": { "$ref": "#/$defs/address" } },
    "observations": {
      "type": "array", "minItems": 10, "maxItems": 10,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["ordinal", "nonce", "deployment", "address", "transaction_hash", "block_hash", "block_number", "runtime_code_hash", "runtime_bytes"],
        "properties": {
          "ordinal": { "type": "integer", "minimum": 1, "maximum": 10 },
          "nonce": { "type": "integer", "minimum": 1, "maximum": 10 },
          "deployment": { "type": "string", "minLength": 1 },
          "address": { "$ref": "#/$defs/address" },
          "transaction_hash": { "$ref": "#/$defs/bytes32" },
          "block_hash": { "$ref": "#/$defs/bytes32" },
          "block_number": { "type": "integer", "minimum": 0 },
          "runtime_code_hash": { "$ref": "#/$defs/bytes32" },
          "runtime_bytes": { "type": "integer", "minimum": 1, "maximum": 24576 }
        }
      }
    },
    "modules": { "type": "object", "minProperties": 3, "maxProperties": 3 },
    "coordinator_links": { "type": "object", "required": ["creation", "runtime"], "additionalProperties": false, "properties": { "creation": { "$ref": "#/$defs/linkArtifact" }, "runtime": { "$ref": "#/$defs/linkArtifact" } } },
    "role_absence": {
      "type": "object", "additionalProperties": false, "required": ["before", "after"],
      "properties": { "before": { "$ref": "#/$defs/roleObservation" }, "after": { "$ref": "#/$defs/roleObservation" } }
    }
  },
  "$defs": {
    "address": { "type": "string", "pattern": "^0x[0-9a-f]{40}$", "not": { "const": "0x0000000000000000000000000000000000000000" } },
    "broadcasterProvenance": {
      "type": "object", "additionalProperties": false,
      "required": ["provider", "account_profile", "account_index", "address", "account_set_sha256", "unlocked", "private_key_input"],
      "properties": {
        "provider": { "const": "anvil" },
        "account_profile": { "const": "foundry-default-account-1" },
        "account_index": { "const": 1 },
        "address": { "const": "0x70997970c51812dc3a010c7d01b50e0d17dc79c8" },
        "account_set_sha256": { "const": "sha256:19901d67310664f0f09541131dbc6669f2aa9ce4ffdb1cf497d8a7da8d1ba307" },
        "unlocked": { "const": true },
        "private_key_input": { "const": false }
      }
    },
    "bytes32": { "type": "string", "pattern": "^0x[0-9a-f]{64}$" },
    "link": { "type": "object", "additionalProperties": false, "required": ["source", "library", "start", "length"], "properties": { "source": { "const": "src/resolution/RefinanceCoordinator.sol" }, "library": { "type": "string" }, "start": { "type": "integer", "minimum": 0 }, "length": { "const": 20 } } },
    "linkArtifact": { "type": "object", "additionalProperties": false, "required": ["entries", "linked_code_hash", "linked_bytes", "reproduced_executable_hash"], "properties": { "entries": { "type": "array", "minItems": 7, "maxItems": 7, "items": { "$ref": "#/$defs/link" } }, "linked_code_hash": { "$ref": "#/$defs/bytes32" }, "linked_bytes": { "type": "integer", "minimum": 1, "maximum": 49152 }, "reproduced_executable_hash": { "$ref": "#/$defs/bytes32" } } },
    "roleObservation": { "type": "object", "additionalProperties": false, "required": ["block_hash", "role_expiry", "has_role"], "properties": { "block_hash": { "$ref": "#/$defs/bytes32" }, "role_expiry": { "const": "0" }, "has_role": { "const": false } } },
    "finalNonceTranscript": {
      "type": "object", "additionalProperties": false,
      "required": ["latest_before", "pending_before", "preparation_method", "preparation_value", "preparation_result", "latest_prepared", "pending_prepared", "latest_final", "pending_final"],
      "properties": {
        "latest_before": { "const": "0x0" }, "pending_before": { "const": "0x0" },
        "preparation_method": { "const": "anvil_setNonce" }, "preparation_value": { "const": "0x1" }, "preparation_result": { "type": "null" },
        "latest_prepared": { "const": "0x1" }, "pending_prepared": { "const": "0x1" },
        "latest_final": { "const": "0xb" }, "pending_final": { "const": "0xb" }
      }
    }
  }
}
