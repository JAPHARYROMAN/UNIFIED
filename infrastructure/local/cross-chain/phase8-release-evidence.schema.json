{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unified.local/schemas/phase8-release-evidence-v1.json",
  "title": "UNIFIED Phase 8 local release evidence",
  "description": "Final completed form of the sole authoritative local release bundle. Receipt identity is checked against live local RPCs and independently against Ed25519-authenticated local headers with transaction/receipt MPT inclusion. The local header authority is not EVM consensus or a production light client. Live semantic checks are enforced by tools/check_phase8_release_evidence.py.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "environment",
    "contains_real_value",
    "run_id",
    "protocol_id",
    "proof_boundary",
    "generated_at",
    "source_commit",
    "deployment_flow_sha256",
    "domains",
    "routes",
    "exposure_policy",
    "recovery",
    "providers",
    "flow",
    "durable",
    "reset",
    "validation"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "artifact_type": { "const": "PHASE8_RELEASE_EVIDENCE" },
    "environment": { "const": "local" },
    "contains_real_value": { "const": false },
    "run_id": { "$ref": "#/$defs/text" },
    "protocol_id": { "$ref": "#/$defs/hex32" },
    "proof_boundary": { "const": "AUTHENTICATED_SIGNED_HEADER_TX_RECEIPT_MPT" },
    "generated_at": { "type": "string", "format": "date-time" },
    "source_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "deployment_flow_sha256": { "$ref": "#/$defs/sha256" },
    "domains": {
      "type": "object",
      "additionalProperties": false,
      "required": ["home", "satellite"],
      "properties": {
        "home": { "$ref": "#/$defs/domain" },
        "satellite": { "$ref": "#/$defs/domain" }
      }
    },
    "routes": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": { "$ref": "#/$defs/route" }
    },
    "exposure_policy": { "$ref": "#/$defs/exposurePolicy" },
    "recovery": { "$ref": "#/$defs/recovery" },
    "providers": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": { "$ref": "#/$defs/provider" }
    },
    "flow": { "$ref": "#/$defs/flow" },
    "durable": { "$ref": "#/$defs/durable" },
    "reset": { "$ref": "#/$defs/reset" },
    "validation": { "$ref": "#/$defs/validation" }
  },
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1
    },
    "hex20": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{40}$"
    },
    "hex32": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{64}$"
    },
    "hexBytes": {
      "type": "string",
      "pattern": "^0x(?:[0-9a-f]{2})+$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "uint": {
      "type": "integer",
      "minimum": 0
    },
    "positiveUint": {
      "type": "integer",
      "minimum": 1
    },
    "decimal": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]*)$"
    },
    "addressReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["domain", "chain_id", "address"],
      "properties": {
        "domain": { "enum": ["home", "satellite"] },
        "chain_id": { "$ref": "#/$defs/positiveUint" },
        "address": { "$ref": "#/$defs/hex20" }
      }
    },
    "creationEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "emitter",
        "signature",
        "topic0",
        "indexed_id",
        "indexed_id_topic_position",
        "indexed_address_topic_position"
      ],
      "properties": {
        "emitter": { "$ref": "#/$defs/hex20" },
        "signature": {
          "const": "CrossChainLoanCreated(bytes32,address,address,address,bytes32)"
        },
        "topic0": { "$ref": "#/$defs/hex32" },
        "indexed_id": { "$ref": "#/$defs/hex32" },
        "indexed_id_topic_position": { "const": 1 },
        "indexed_address_topic_position": { "const": 2 }
      }
    },
    "contract": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "address",
            "runtime_code_hash",
            "abi_path",
            "abi_sha256",
            "deployment_kind",
            "deployment_tx_hash",
            "deployment_block_number"
          ],
          "properties": {
            "address": { "$ref": "#/$defs/hex20" },
            "runtime_code_hash": { "$ref": "#/$defs/hex32" },
            "abi_path": { "$ref": "#/$defs/text" },
            "abi_sha256": { "$ref": "#/$defs/sha256" },
            "deployment_kind": { "const": "CREATE_TRANSACTION" },
            "deployment_tx_hash": { "$ref": "#/$defs/hex32" },
            "deployment_block_number": { "$ref": "#/$defs/positiveUint" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "address",
            "runtime_code_hash",
            "abi_path",
            "abi_sha256",
            "deployment_kind",
            "deployment_tx_hash",
            "deployment_block_number",
            "creation_event"
          ],
          "properties": {
            "address": { "$ref": "#/$defs/hex20" },
            "runtime_code_hash": { "$ref": "#/$defs/hex32" },
            "abi_path": { "$ref": "#/$defs/text" },
            "abi_sha256": { "$ref": "#/$defs/sha256" },
            "deployment_kind": { "const": "INTERNAL_CREATE2" },
            "deployment_tx_hash": { "$ref": "#/$defs/hex32" },
            "deployment_block_number": { "$ref": "#/$defs/positiveUint" },
            "creation_event": { "$ref": "#/$defs/creationEvent" }
          }
        }
      ]
    },
    "signerSet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "hash",
        "threshold",
        "valid_from",
        "valid_until",
        "sorted_addresses"
      ],
      "properties": {
        "version": { "const": 1 },
        "hash": { "$ref": "#/$defs/hex32" },
        "threshold": { "const": 2 },
        "valid_from": { "$ref": "#/$defs/positiveUint" },
        "valid_until": { "$ref": "#/$defs/positiveUint" },
        "sorted_addresses": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": { "$ref": "#/$defs/hex20" }
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "route_purpose",
        "policy_hash",
        "destination_evidence",
        "source_chain_id",
        "source_coordinator",
        "source_component",
        "destination_chain_id",
        "destination_coordinator",
        "destination_component",
        "evidence_chain_version",
        "evidence_chain_configuration_hash",
        "action_family",
        "allowed_actions_bitmap",
        "required_depth",
        "observer_authority_hash",
        "signer_set_hash",
        "signer_set_version"
      ],
      "properties": {
        "route_purpose": { "$ref": "#/$defs/text" },
        "policy_hash": { "$ref": "#/$defs/hex32" },
        "destination_evidence": { "type": "boolean" },
        "source_chain_id": { "$ref": "#/$defs/positiveUint" },
        "source_coordinator": { "$ref": "#/$defs/hex20" },
        "source_component": { "$ref": "#/$defs/hex20" },
        "destination_chain_id": { "$ref": "#/$defs/positiveUint" },
        "destination_coordinator": { "$ref": "#/$defs/hex20" },
        "destination_component": { "$ref": "#/$defs/hex20" },
        "evidence_chain_version": { "$ref": "#/$defs/positiveUint" },
        "evidence_chain_configuration_hash": { "$ref": "#/$defs/hex32" },
        "action_family": { "$ref": "#/$defs/hex32" },
        "allowed_actions_bitmap": { "$ref": "#/$defs/positiveUint" },
        "required_depth": { "$ref": "#/$defs/positiveUint" },
        "observer_authority_hash": { "$ref": "#/$defs/hex32" },
        "signer_set_hash": { "$ref": "#/$defs/hex32" },
        "signer_set_version": { "$ref": "#/$defs/positiveUint" }
      }
    },
    "domain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "chain_id",
        "chain_version",
        "rpc_url",
        "genesis_hash",
        "configuration_hash",
        "activation_block",
        "activation_timestamp",
        "registry_status",
        "observer_fixture",
        "observer_public_key_ed25519",
        "observer_authority_hash",
        "confirmation_depth",
        "signer_set",
        "contracts",
        "registry_bindings",
        "finality_policies"
      ],
      "properties": {
        "chain_id": { "$ref": "#/$defs/positiveUint" },
        "chain_version": { "const": 1 },
        "rpc_url": { "type": "string", "pattern": "^http://(?:127\\.0\\.0\\.1|localhost|\\[::1\\]):[0-9]+$" },
        "genesis_hash": { "$ref": "#/$defs/hex32" },
        "configuration_hash": { "$ref": "#/$defs/hex32" },
        "activation_block": { "$ref": "#/$defs/uint" },
        "activation_timestamp": { "$ref": "#/$defs/positiveUint" },
        "registry_status": { "const": "ACTIVE" },
        "observer_fixture": { "$ref": "#/$defs/text" },
        "observer_public_key_ed25519": { "$ref": "#/$defs/hex32" },
        "observer_authority_hash": { "$ref": "#/$defs/hex32" },
        "confirmation_depth": { "$ref": "#/$defs/positiveUint" },
        "signer_set": { "$ref": "#/$defs/signerSet" },
        "contracts": {
          "type": "object",
          "minProperties": 12,
          "additionalProperties": { "$ref": "#/$defs/contract" }
        },
        "registry_bindings": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "route_registry_chain_registry",
            "finality_verifier_chain_registry"
          ],
          "properties": {
            "route_registry_chain_registry": { "$ref": "#/$defs/hex20" },
            "finality_verifier_chain_registry": { "$ref": "#/$defs/hex20" }
          }
        },
        "finality_policies": {
          "type": "array",
          "minItems": 14,
          "maxItems": 14,
          "items": { "$ref": "#/$defs/policy" }
        }
      }
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "purpose",
        "version",
        "route_policy_hash",
        "source_domain",
        "destination_domain",
        "source_chain_version",
        "destination_chain_version",
        "source_chain_id",
        "source_coordinator",
        "source_component",
        "source_component_code_hash",
        "destination_chain_id",
        "destination_coordinator",
        "destination_component",
        "destination_component_code_hash",
        "action_family",
        "allowed_actions_bitmap",
        "adapter_id",
        "adapter_code_hash",
        "adapter_set_policy_hash",
        "source_finality_policy_hash",
        "destination_finality_policy_hash",
        "source_signer_set_hash",
        "destination_signer_set_hash",
        "absolute_cap_units",
        "chain_cap_units",
        "adapter_cap_units",
        "activated_at",
        "home_registration_tx_hash",
        "home_registration_block_number",
        "satellite_registration_tx_hash",
        "satellite_registration_block_number",
        "home_registry_hash",
        "satellite_registry_hash"
      ],
      "properties": {
        "purpose": { "enum": ["MINT", "REPORT", "REPAYMENT", "ALTERNATE_REPAYMENT", "BRIDGE_EXIT", "DISBURSEMENT", "COLLATERAL_RELEASE"] },
        "version": { "const": 1 },
        "route_policy_hash": { "$ref": "#/$defs/hex32" },
        "source_domain": { "enum": ["home", "satellite"] },
        "destination_domain": { "enum": ["home", "satellite"] },
        "source_chain_version": { "const": 1 },
        "destination_chain_version": { "const": 1 },
        "source_chain_id": { "$ref": "#/$defs/positiveUint" },
        "source_coordinator": { "$ref": "#/$defs/hex20" },
        "source_component": { "$ref": "#/$defs/hex20" },
        "source_component_code_hash": { "$ref": "#/$defs/hex32" },
        "destination_chain_id": { "$ref": "#/$defs/positiveUint" },
        "destination_coordinator": { "$ref": "#/$defs/hex20" },
        "destination_component": { "$ref": "#/$defs/hex20" },
        "destination_component_code_hash": { "$ref": "#/$defs/hex32" },
        "action_family": { "$ref": "#/$defs/hex32" },
        "allowed_actions_bitmap": { "$ref": "#/$defs/positiveUint" },
        "adapter_id": { "$ref": "#/$defs/hex32" },
        "adapter_code_hash": { "$ref": "#/$defs/hex32" },
        "adapter_set_policy_hash": { "$ref": "#/$defs/hex32" },
        "source_finality_policy_hash": { "$ref": "#/$defs/hex32" },
        "destination_finality_policy_hash": { "$ref": "#/$defs/hex32" },
        "source_signer_set_hash": { "$ref": "#/$defs/hex32" },
        "destination_signer_set_hash": { "$ref": "#/$defs/hex32" },
        "absolute_cap_units": { "$ref": "#/$defs/decimal" },
        "chain_cap_units": { "$ref": "#/$defs/decimal" },
        "adapter_cap_units": { "$ref": "#/$defs/decimal" },
        "activated_at": { "$ref": "#/$defs/positiveUint" },
        "home_registration_tx_hash": { "$ref": "#/$defs/hex32" },
        "home_registration_block_number": { "$ref": "#/$defs/positiveUint" },
        "satellite_registration_tx_hash": { "$ref": "#/$defs/hex32" },
        "satellite_registration_block_number": { "$ref": "#/$defs/positiveUint" },
        "home_registry_hash": { "$ref": "#/$defs/hex32" },
        "satellite_registry_hash": { "$ref": "#/$defs/hex32" }
      }
    },
    "exposurePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_version",
        "policy_hash",
        "circulating_supply_reference_units",
        "circulating_supply_evidence_hash",
        "route_absolute_cap_units",
        "chain_absolute_cap_units",
        "adapter_absolute_cap_units",
        "aggregate_absolute_cap_units",
        "route_percentage_ceiling_basis_points",
        "aggregate_percentage_ceiling_basis_points",
        "activation_delay",
        "active_from"
      ],
      "properties": {
        "policy_version": { "const": 1 },
        "policy_hash": { "$ref": "#/$defs/hex32" },
        "circulating_supply_reference_units": { "$ref": "#/$defs/decimal" },
        "circulating_supply_evidence_hash": { "$ref": "#/$defs/hex32" },
        "route_absolute_cap_units": { "$ref": "#/$defs/decimal" },
        "chain_absolute_cap_units": { "$ref": "#/$defs/decimal" },
        "adapter_absolute_cap_units": { "$ref": "#/$defs/decimal" },
        "aggregate_absolute_cap_units": { "$ref": "#/$defs/decimal" },
        "route_percentage_ceiling_basis_points": { "const": 500 },
        "aggregate_percentage_ceiling_basis_points": { "const": 1500 },
        "activation_delay": { "const": 0 },
        "active_from": { "$ref": "#/$defs/positiveUint" }
      }
    },
    "recovery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action",
        "threshold",
        "authorizer_set_version",
        "authorizer_set_hash",
        "sorted_authorizer_addresses"
      ],
      "properties": {
        "action": { "const": "TOMBSTONE_THEN_COMPENSATE" },
        "threshold": { "const": 2 },
        "authorizer_set_version": { "const": 1 },
        "authorizer_set_hash": { "$ref": "#/$defs/hex32" },
        "sorted_authorizer_addresses": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": { "$ref": "#/$defs/hex20" }
        }
      }
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "url", "authority"],
      "properties": {
        "id": { "enum": ["mock-bridge-provider-a", "mock-bridge-provider-b"] },
        "url": { "type": "string", "pattern": "^http://(?:127\\.0\\.0\\.1|localhost|\\[::1\\]):[0-9]+$" },
        "authority": { "const": "TRANSPORT_ONLY" }
      }
    },
    "envelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "message_id",
        "protocol_id",
        "source_chain_id",
        "source_coordinator",
        "source_component",
        "destination_chain_id",
        "destination_coordinator",
        "destination_component",
        "lane_id",
        "source_nonce",
        "aggregate_id",
        "action_ordinal",
        "payload_hash",
        "created_at",
        "expires_at",
        "route_policy_hash",
        "adapter_set_policy_hash",
        "source_finality_policy_hash",
        "destination_finality_policy_hash",
        "correlation_id",
        "causation_message_id",
        "superseded_message_id"
      ],
      "properties": {
        "schema_version": { "const": 1 },
        "message_id": { "$ref": "#/$defs/hex32" },
        "protocol_id": { "$ref": "#/$defs/hex32" },
        "source_chain_id": { "$ref": "#/$defs/positiveUint" },
        "source_coordinator": { "$ref": "#/$defs/hex20" },
        "source_component": { "$ref": "#/$defs/hex20" },
        "destination_chain_id": { "$ref": "#/$defs/positiveUint" },
        "destination_coordinator": { "$ref": "#/$defs/hex20" },
        "destination_component": { "$ref": "#/$defs/hex20" },
        "lane_id": { "$ref": "#/$defs/hex32" },
        "source_nonce": { "$ref": "#/$defs/positiveUint" },
        "aggregate_id": { "$ref": "#/$defs/hex32" },
        "action_ordinal": { "$ref": "#/$defs/positiveUint" },
        "payload_hash": { "$ref": "#/$defs/hex32" },
        "created_at": { "$ref": "#/$defs/positiveUint" },
        "expires_at": { "$ref": "#/$defs/positiveUint" },
        "route_policy_hash": { "$ref": "#/$defs/hex32" },
        "adapter_set_policy_hash": { "$ref": "#/$defs/hex32" },
        "source_finality_policy_hash": { "$ref": "#/$defs/hex32" },
        "destination_finality_policy_hash": { "$ref": "#/$defs/hex32" },
        "correlation_id": { "$ref": "#/$defs/hex32" },
        "causation_message_id": { "$ref": "#/$defs/hex32" },
        "superseded_message_id": { "$ref": "#/$defs/hex32" }
      }
    },
    "proof": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_block_hash",
        "source_block_number",
        "source_block_timestamp",
        "transaction_hash",
        "transaction_index",
        "receipt_root",
        "receipt_proof_hash",
        "log_index",
        "event_hash",
        "finality_head_hash",
        "finality_head_number",
        "required_depth",
        "header_authority_hash",
        "observer_signed_header_commitment",
        "observer_signature",
        "finality_policy_hash"
      ],
      "properties": {
        "source_block_hash": { "$ref": "#/$defs/hex32" },
        "source_block_number": { "$ref": "#/$defs/positiveUint" },
        "source_block_timestamp": { "$ref": "#/$defs/positiveUint" },
        "transaction_hash": { "$ref": "#/$defs/hex32" },
        "transaction_index": { "$ref": "#/$defs/uint" },
        "receipt_root": { "$ref": "#/$defs/hex32" },
        "receipt_proof_hash": { "$ref": "#/$defs/hex32" },
        "log_index": { "$ref": "#/$defs/uint" },
        "event_hash": { "$ref": "#/$defs/hex32" },
        "finality_head_hash": { "$ref": "#/$defs/hex32" },
        "finality_head_number": { "$ref": "#/$defs/positiveUint" },
        "required_depth": { "$ref": "#/$defs/positiveUint" },
        "header_authority_hash": { "$ref": "#/$defs/hex32" },
        "observer_signed_header_commitment": { "$ref": "#/$defs/hex32" },
        "observer_signature": {
          "type": "string",
          "pattern": "^0x[0-9a-f]{128}$"
        },
        "finality_policy_hash": { "$ref": "#/$defs/hex32" }
      }
    },
    "authenticatedHeader": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "header_rlp",
        "header_observed_at_unix_nanos",
        "header_signature_ed25519"
      ],
      "properties": {
        "header_rlp": { "$ref": "#/$defs/hexBytes" },
        "header_observed_at_unix_nanos": { "$ref": "#/$defs/decimal" },
        "header_signature_ed25519": {
          "type": "string",
          "pattern": "^0x[0-9a-f]{128}$"
        }
      }
    },
    "receiptInclusion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "transaction_index",
        "transaction_rlp",
        "transaction_proof_nodes",
        "receipt_rlp",
        "receipt_proof_nodes"
      ],
      "properties": {
        "transaction_index": { "$ref": "#/$defs/uint" },
        "transaction_rlp": { "$ref": "#/$defs/hexBytes" },
        "transaction_proof_nodes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": { "$ref": "#/$defs/hexBytes" }
        },
        "receipt_rlp": { "$ref": "#/$defs/hexBytes" },
        "receipt_proof_nodes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": { "$ref": "#/$defs/hexBytes" }
        }
      }
    },
    "authenticatedInclusion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "header_rlp",
        "header_observed_at_unix_nanos",
        "header_signature_ed25519",
        "receipts",
        "confirmation_headers"
      ],
      "properties": {
        "header_rlp": { "$ref": "#/$defs/hexBytes" },
        "header_observed_at_unix_nanos": { "$ref": "#/$defs/decimal" },
        "header_signature_ed25519": {
          "type": "string",
          "pattern": "^0x[0-9a-f]{128}$"
        },
        "receipts": {
          "type": "array",
          "description": "Prefix-complete transaction/receipt inclusions at indices 0 through proof.transaction_index. The last element is the target receipt; target_index is therefore proof.transaction_index and is not independently caller-selectable.",
          "minItems": 1,
          "maxItems": 4096,
          "items": { "$ref": "#/$defs/receiptInclusion" }
        },
        "confirmation_headers": {
          "type": "array",
          "description": "Exactly proof.required_depth signed headers, beginning at source_block_number + 1, parent-linked to the inclusion header, and ending at proof.finality_head_hash/number.",
          "minItems": 1,
          "maxItems": 4096,
          "items": { "$ref": "#/$defs/authenticatedHeader" }
        }
      }
    },
    "certificate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "message_id",
        "source_proof_hash",
        "signer_set_hash",
        "signer_set_version",
        "signatures"
      ],
      "properties": {
        "message_id": { "$ref": "#/$defs/hex32" },
        "source_proof_hash": { "$ref": "#/$defs/hex32" },
        "signer_set_hash": { "$ref": "#/$defs/hex32" },
        "signer_set_version": { "const": 1 },
