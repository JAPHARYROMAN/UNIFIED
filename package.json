{
  "name": "@unified/root",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": "22.13.1",
    "pnpm": "10.28.2"
  },
  "scripts": {
    "build": "tsc --build",
    "check": "tsc --build --pretty false",
    "clean": "tsc --build --clean",
    "solidity:compile": "solcjs --base-path . --include-path node_modules --abi --bin -o .cache/solc protocol/src/ProtocolCompilation.sol"
  },
  "devDependencies": {
    "@bufbuild/protobuf": "2.13.0",
    "@bufbuild/protoc-gen-es": "2.13.0",
    "@openzeppelin/contracts": "5.6.1",
    "solc": "0.8.36",
    "typescript": "7.0.2"
  },
  "pnpm": {
    "overrides": {
      "tmp": "0.2.7"
    }
  }
}
